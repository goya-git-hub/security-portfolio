---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const pageTitle = isHome ? 'Wexmoor: operations data for fleets and parts' : `${title} | Wexmoor`;

const nav = [
  { href: '/product/', label: 'Product' },
  { href: '/about/', label: 'About' },
  { href: '/trust/', label: 'Trust Center' },
];
const current = (href: string) => (path === href ? 'page' : undefined);
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="wordmark" href="/" aria-current={current('/')}>
          <span class="wordmark-tag" aria-hidden="true">W</span>
          <span class="wordmark-name">Wexmoor</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <a class="wordmark wordmark-small" href="/">
          <span class="wordmark-tag" aria-hidden="true">W</span>
          <span class="wordmark-name">Wexmoor</span>
        </a>
        <nav class="footer-nav" aria-label="Footer">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <p class="footer-note">Wexmoor is a fictional company created as a security portfolio by Goya. All staff, customers, datasets, and files are fictional or synthetic.</p>
      </div>
    </footer>
  </body>
</html>
