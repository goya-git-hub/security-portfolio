---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const moves = [
  { record: 'Bus 4127', detail: 'Fault code P0217', count: '3', unit: 'trips', call: 'Inspect' },
  { record: 'Lot BK-0918', detail: 'Supplier Fernlake', count: '1,200', unit: 'parts', call: 'Hold' },
  { record: 'Truck 218', detail: 'Odometer 84,220 km', count: '41', unit: 'trips', call: 'On plan' },
  { record: 'Lot WH-2231', detail: 'Received Oct 6', count: '480', unit: 'parts', call: 'Inspect' },
  { record: 'Van 0563', detail: 'Odometer 62,310 km', count: '12', unit: 'trips', call: 'On plan' },
];
const callClass: Record<string, string> = {
  Inspect: 'tag tag-label',
  'On plan': 'tag tag-plan',
  Hold: 'tag tag-hold',
};

const capabilities = [
  {
    term: 'Fleet telemetry workspace',
    text: 'Trips, fault codes, and odometer readings for every vehicle in one view, so maintenance is planned before a breakdown, not after one.',
  },
  {
    term: 'Part and shipment records you can trace',
    text: 'Every lot keeps its supplier, its received date, and the vehicles it went into, so a recall reaches the right parts first.',
  },
  {
    term: 'Access you can audit',
    text: 'Each customer sees only its own workspace. Staff need an approved, time-limited reason to open customer data, and every look is logged.',
  },
];

const steps = [
  { name: 'Connect', text: 'Telematics feeds, shipment files, and carrier events arrive from the systems you already use.' },
  { name: 'Check', text: 'Every file is validated. Bad rows are set aside and reported, never guessed at.' },
  { name: 'Link', text: "Each part lot is matched to its supplier and its vehicles, and compared with last week's records." },
  { name: 'Act', text: 'Fleet and supply teams start the day with a short list of vehicles and lots to check.' },
];

const customers = [
  { name: 'Northline Parts', className: 'logo-northline' },
  { name: 'Cascade Freight', className: 'logo-cascade' },
  { name: 'Harbourview Transit', className: 'logo-harbourview' },
  { name: 'Prairie Supply Co.', className: 'logo-prairie' },
];
---
<BaseLayout
  title="Home"
  description="Wexmoor joins vehicle telematics with part and shipment records, so fleets and suppliers see how each vehicle runs and where each part came from."
>
  <section class="section hero" aria-labelledby="hero-title">
    <div>
      <h1 id="hero-title">Trace every part to the vehicle it keeps running.</h1>
      <p class="lede">Wexmoor brings vehicle telematics and part shipment records into one place, so fleets and suppliers see how each vehicle runs and where each part came from.</p>
      <div class="actions">
        <a class="button" href="/product/">See the product</a>
        <a class="text-link" href="/trust/">Read the Trust Center</a>
      </div>
    </div>
    <figure class="manifest" aria-labelledby="manifest-title">
      <div class="manifest-head">
        <p class="manifest-title" id="manifest-title">Tuesday's checks</p>
        <p class="manifest-meta">Depot 04 and receiving dock, last 24 hours</p>
      </div>
      <table class="manifest-table" aria-labelledby="manifest-title">
        <thead>
          <tr>
            <th scope="col">Record</th>
            <th scope="col">Detail</th>
            <th scope="col" class="num">Count</th>
            <th scope="col">Call</th>
          </tr>
        </thead>
        <tbody>
          {moves.map((move) => (
            <tr>
              <th scope="row" class="m-store">{move.record}</th>
              <td class="m-item">{move.detail}</td>
              <td class="m-units num">{move.count}<span class="units-word"> {move.unit}</span></td>
              <td class="m-call"><span class={callClass[move.call]}>{move.call}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <figcaption>Refreshed overnight from telematics feeds and supplier shipment files.</figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="does-title">
    <div class="section-head">
      <h2 id="does-title">What Wexmoor does</h2>
    </div>
    <dl class="def-list">
      {capabilities.map((item) => (
        <div>
          <dt>{item.term}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="moves-title">
    <div class="section-head">
      <h2 id="moves-title">How your data moves</h2>
      <p>Four steps, every night, with nothing for your team to run by hand.</p>
    </div>
    <ol class="pipeline">
      {steps.map((step, index) => (
        <li>
          <span class="stop" aria-hidden="true">{index + 1}</span>
          <h3>{step.name}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="customers-title">
    <div class="section-head">
      <h2 id="customers-title">Teams that keep vehicles moving with Wexmoor</h2>
    </div>
    <ul class="customers">
      {customers.map((customer) => (
        <li><span class={customer.className}>{customer.name}</span></li>
      ))}
    </ul>
    <p class="customers-note">Built for car-parts suppliers, transit and city fleets, and freight carriers. The names are fictional, like the company.</p>
  </section>

  <section class="band" aria-labelledby="band-title">
    <div class="wrap band-inner">
      <div class="band-copy">
        <h2 id="band-title">Security you can check</h2>
        <p>Our Trust Center lists every control on this website with its real state, in place or planned. Nothing is marked done until it works.</p>
      </div>
      <a class="button button-label" href="/trust/">Read the Trust Center</a>
    </div>
  </section>
</BaseLayout>
