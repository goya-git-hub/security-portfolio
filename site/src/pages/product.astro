---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const inputs = [
  { term: 'Vehicle telematics', text: "Trips, fault codes, and odometer readings from each vehicle's onboard unit." },
  { term: 'Part shipments', text: 'Lot numbers, suppliers, and received dates from your parts and receiving systems.' },
  { term: 'Carrier tracking', text: 'Pickup and delivery events from your carriers, matched to each shipment.' },
  { term: 'Supplier files', text: 'Lead times and order confirmations, sent by secure file transfer.' },
];

const outputs = [
  {
    term: 'A morning check list',
    text: 'The handful of vehicles and part lots worth checking today, each with the reason it was flagged.',
  },
  {
    term: 'Part histories',
    text: 'For every lot, the supplier, the received date, and each vehicle it went into, ready for a recall or a supplier review.',
  },
  {
    term: 'Lane reports',
    text: 'On-time rates and delays for every carrier and route, ready for the next contract review.',
  },
];

const specs = [
  { name: 'Data refresh', value: 'Every night, from every connected source.' },
  { name: 'History', value: 'Three years of trips, fault codes, and shipments.' },
  { name: 'Level of detail', value: 'Every vehicle, every trip, and every part lot.' },
  { name: 'Exports', value: 'CSV and Parquet files, or a shared dataset for your own analysts.' },
  {
    name: 'Customer workspaces',
    value: 'Invite-only sign-in for your team, with separate roles for administrators and users.',
    tag: 'In development',
  },
];
---
<BaseLayout
  title="Product"
  description="Wexmoor connects vehicle telematics, part shipments, carrier tracking, and supplier files, then shows teams which vehicles and parts need attention next."
>
  <section class="section page-head" aria-labelledby="page-title">
    <h1 id="page-title">One place for the data that keeps vehicles moving</h1>
    <p class="lede">Wexmoor connects what your vehicles report, what your suppliers ship, and what you receive, then shows your teams which vehicles and parts need attention next.</p>
  </section>

  <section class="section" aria-labelledby="connect-title">
    <div class="section-head">
      <h2 id="connect-title">What you connect</h2>
    </div>
    <dl class="def-list">
      {inputs.map((item) => (
        <div>
          <dt>{item.term}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="get-title">
    <div class="section-head">
      <h2 id="get-title">What your teams get</h2>
    </div>
    <dl class="def-list">
      {outputs.map((item) => (
        <div>
          <dt>{item.term}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="glance-title">
    <div class="section-head">
      <h2 id="glance-title">At a glance</h2>
    </div>
    <div class="table-block">
      <table class="data-table spec" aria-labelledby="glance-title">
        <tbody>
          {specs.map((spec) => (
            <tr>
              <th scope="row">{spec.name}</th>
              <td>
                {spec.value}
                {spec.tag && <span class="tag tag-plan">{spec.tag}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="band" aria-labelledby="band-title">
    <div class="wrap band-inner">
      <div class="band-copy">
        <h2 id="band-title">Your data, handled in the open</h2>
        <p>How this website is protected, control by control, with each one's real state.</p>
      </div>
      <a class="button button-label" href="/trust/">Read the Trust Center</a>
    </div>
  </section>
</BaseLayout>
