---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const inputs = [
  { term: 'Store sales', text: 'Daily exports from your point-of-sale system, by store and item.' },
  { term: 'Warehouse stock', text: 'On-hand and in-transit inventory from your warehouse management system.' },
  { term: 'Carrier tracking', text: 'Pickup and delivery events from your carriers, matched to each shipment.' },
  { term: 'Supplier files', text: 'Lead times and order confirmations, sent by secure file transfer.' },
];

const outputs = [
  {
    term: 'A morning move list',
    text: 'The handful of transfers and orders worth making today, each with the reason and the expected saving.',
  },
  {
    term: 'Store forecasts',
    text: 'Twelve weeks ahead, by day, for every item in every store, with the range of likely outcomes, not just one number.',
  },
  {
    term: 'Lane reports',
    text: 'On-time rates and delays for every carrier and route, ready for the next contract review.',
  },
];

const specs = [
  { name: 'Data refresh', value: 'Every night, from every connected source.' },
  { name: 'Forecast range', value: 'Twelve weeks ahead, by day.' },
  { name: 'Level of detail', value: 'Every item, in every store and warehouse.' },
  { name: 'Exports', value: 'CSV and Parquet files, or a shared dataset for your own analysts.' },
  {
    name: 'Customer workspaces',
    value: 'Sign-in for your team, with separate roles for administrators and users.',
    tag: 'In development',
  },
];
---
<BaseLayout
  title="Product"
  description="Wexmoor connects store sales, warehouse stock, carrier tracking, and supplier files, then tells planners where inventory should go next."
>
  <section class="section page-head" aria-labelledby="page-title">
    <h1 id="page-title">One place for the data that moves your goods</h1>
    <p class="lede">Wexmoor connects what you sell, what you stock, and what you ship, then tells your planners where inventory should go next.</p>
  </section>

  <section class="section" aria-labelledby="connect-title">
    <div class="section-head">
      <h2 id="connect-title">What you connect</h2>
    </div>
    <dl class="def-list">
      {inputs.map((item) => (
        <div>
          <dt>{item.term}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="get-title">
    <div class="section-head">
      <h2 id="get-title">What your planners get</h2>
    </div>
    <dl class="def-list">
      {outputs.map((item) => (
        <div>
          <dt>{item.term}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="glance-title">
    <div class="section-head">
      <h2 id="glance-title">At a glance</h2>
    </div>
    <div class="table-block">
      <table class="data-table spec" aria-labelledby="glance-title">
        <tbody>
          {specs.map((spec) => (
            <tr>
              <th scope="row">{spec.name}</th>
              <td>
                {spec.value}
                {spec.tag && <span class="tag tag-plan">{spec.tag}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="band" aria-labelledby="band-title">
    <div class="wrap band-inner">
      <div class="band-copy">
        <h2 id="band-title">Your data, handled in the open</h2>
        <p>How this website is protected, control by control, with each one's real state.</p>
      </div>
      <a class="button button-label" href="/trust/">Read the Trust Center</a>
    </div>
  </section>
</BaseLayout>
