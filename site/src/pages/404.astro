---
// Rendered by the Worker, not pre-built: only requests that match no file
// reach this code, so every one of them is recorded in Workers Logs.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found"
  description="There is no page at this address on the Wexmoor website."
>
  <section class="section page-head" aria-labelledby="page-title">
    <h1 id="page-title">Page not found</h1>
    <p class="lede">There is no page at this address. It may have moved, or the link may be mistyped.</p>
    <div class="actions">
      <a class="button" href="/">Go to the home page</a>
      <a class="text-link" href="/trust/">Read the Trust Center</a>
    </div>
  </section>
</BaseLayout>
