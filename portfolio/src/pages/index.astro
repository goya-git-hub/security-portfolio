---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const catalogue = [
  {
    page: 'Tour',
    href: '/tour/',
    what: "A one-minute walk-through: pick the gate for the role you're hiring for, and see the lab inside the walls.",
    when: 'Open',
  },
  { page: 'About', href: '/about/', what: 'Who I am, the roles I\'m aiming for, and how I work.', when: 'Open' },
  { page: 'Case files', href: '/labs/', what: 'One page per lab, with the evidence beside every claim.', when: 'Open' },
  { page: 'Resume', what: 'A PDF and a plain-text version.', when: 'Arrives in Phase 1' },
];
---
<BaseLayout
  title="Home"
  description="Goya's IT, networking, and security portfolio. Every claim carries the evidence that proves it, or says plainly that the evidence isn't there yet."
>
  <section class="page-head hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Inspect what you let in.</h1>
    <p class="lede">I'm Goya, building a career in IT, networking, and security. Every claim on this site carries the evidence that proves it, or says plainly that the evidence isn't there yet.</p>
    <div class="actions">
      <a class="button" href="/tour/">Take the one-minute tour</a>
      <a class="text-link" href="/about/">About me</a>
    </div>
  </section>

  <section class="section" aria-labelledby="here-title">
    <h2 id="here-title">What's here</h2>
    <div class="table-block">
      <table class="catalogue" aria-labelledby="here-title">
        <thead>
          <tr>
            <th scope="col">Page</th>
            <th scope="col">What it holds</th>
            <th scope="col" class="col-when">When</th>
          </tr>
        </thead>
        <tbody>
          {catalogue.map((row) => (
            <tr>
              <th scope="row">{row.href ? <a href={row.href}>{row.page}</a> : row.page}</th>
              <td class="col-what">{row.what}</td>
              <td class="col-when">
                {row.when === 'Open' ? (
                  <span class="when-open"><span class="seal" aria-hidden="true"></span>Open</span>
                ) : (
                  <span class="when-later">{row.when}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" aria-labelledby="built-title">
    <h2 id="built-title">Built so far</h2>
    <p>Phase 0: a lab of virtual machines, a <a href="https://github.com/goya-git-hub/security-portfolio">public code repository</a> where every change is reviewed before it lands, and the first version of the website for Wexmoor, the fictional company I protect.</p>
  </section>
</BaseLayout>
