---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const gates = [
  {
    role: 'IT support',
    shows: 'A lab of virtual machines built and documented from scratch, broken services diagnosed, and accounts and permissions managed.',
    open: { label: 'Read the lab write-up', href: 'https://github.com/goya-git-hub/security-portfolio/tree/main/labs/00-environment' },
  },
  {
    role: 'Networking',
    shows: 'Packet captures read and explained, a segmented office network designed and tested, and DNS and TLS set up on a real domain.',
    sealedUntil: 'Phase 1',
  },
  {
    role: 'Governance and risk',
    shows: 'Written security policies, a runbook, and a threat model for a live website.',
    sealedUntil: 'Phase 2',
  },
  {
    role: 'Security operations',
    shows: "Phishing is a gift sent by email. This is where I learn to inspect it: investigations, a working SIEM, and detections tested against simulated attacks, including a trojan's persistence and its check-ins.",
    sealedUntil: 'Phase 3',
  },
  {
    role: 'Cloud and web security',
    shows: 'A web application broken, detected, and fixed in a safe training environment, a supply-chain incident rehearsed, and a full restore from backup.',
    sealedUntil: 'Phase 4',
  },
];

const rooms = [
  { name: 'lab-linux', text: 'Ubuntu Server. The practice server for troubleshooting tickets.' },
  { name: 'lab-siem', text: "Ubuntu Server. Collects every machine's logs once the SIEM arrives in Phase 3." },
  { name: 'Kali', text: 'Testing machine. Kept powered off until a lab needs it.' },
  {
    name: 'Windows endpoint (sealed)',
    text: 'A Windows 11 machine to watch and defend. Added in Phase 3.',
    sealed: true,
  },
];
---
<BaseLayout
  title="Tour"
  description="A one-minute walk-through of Goya's portfolio: one gate per role, each leading to the evidence for that job, and the lab inside the walls."
>
  <section class="page-head" aria-labelledby="page-title">
    <h1 id="page-title">Tour</h1>
    <p class="lede">A one-minute walk-through. Pick the gate for the role you're hiring for: each one leads to the evidence for that job.</p>
  </section>

  <section class="section" aria-labelledby="gates-title">
    <h2 id="gates-title">Pick a gate</h2>
    <ul class="gate-legend" aria-label="Legend">
      <li><span class="swatch swatch-open" aria-hidden="true"></span>Open</li>
      <li><span class="swatch swatch-sealed" aria-hidden="true"></span>Sealed until a later phase</li>
    </ul>
    <div class="gates-frame">
      <ol class="gates">
        {gates.map((gate) => (
          <li class:list={['gate', gate.open ? 'gate-open' : 'gate-sealed']}>
            <div class="gate-wall" aria-hidden="true">
              <div class="gate-lintel"></div>
              <div class="gate-opening">{gate.open && <div class="portcullis"></div>}</div>
            </div>
            <div class="gate-body">
              <h3>{gate.role}</h3>
              <p>{gate.shows}</p>
              {gate.open ? (
                <p class="gate-state">
                  <a href={gate.open.href}><span class="seal" aria-hidden="true"></span>{gate.open.label}</a>
                </p>
              ) : (
                <p class="gate-state">Sealed until {gate.sealedUntil}</p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="lab-title">
    <h2 id="lab-title">Inside the walls: the lab</h2>
    <figure class="citadel" aria-labelledby="lab-plan-label">
      <p class="citadel-label" id="lab-plan-label">One Mac running UTM: three machines built, one planned</p>
      <div class="citadel-wall">
        <div class="citadel-inner">
          <ul class="rooms">
            {rooms.map((room) => (
              <li class:list={['room', { 'room-sealed': room.sealed }]}>
                <h3>{room.name}</h3>
                <p>{room.text}</p>
              </li>
            ))}
          </ul>
          <p class="street">
            <span>Shared network</span>
            <span class="street-exit">Out to the internet, through the Mac</span>
          </p>
        </div>
      </div>
      <figcaption>Built rooms have solid walls; the sealed room is planned. The machines reach each other across the shared network and reach the internet through the Mac. Exact addresses are kept private.</figcaption>
    </figure>
  </section>
</BaseLayout>
