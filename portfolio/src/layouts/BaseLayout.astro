---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = path === '/' ? 'Goya: IT, networking, and security portfolio' : `${title} | Goya`;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/tour/', label: 'Tour' },
];

// Oldest first. `built` fills the layer; `current` marks where the work is now.
const layers = [
  { phase: 0, name: 'The lab and first site', built: true, current: true },
  { phase: 1, name: 'Networking', built: false, current: false },
  { phase: 2, name: 'Security foundations', built: false, current: false },
  { phase: 3, name: 'Security operations', built: false, current: false },
  { phase: 4, name: 'Cloud, AI, and web security', built: false, current: false },
  { phase: 5, name: 'Capstone (optional)', built: false, current: false },
];
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/source-sans-3-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <g fill="currentColor">
              <rect x="5" y="12" width="16" height="6" />
              <polygon points="16,12 21,12 25,4.5 21,4.5" />
              <polygon points="20.5,2.5 24.5,2.5 30,6.2 30,9 26.5,9 22.6,6.2" />
              <polygon points="21.2,2.8 22.3,0.4 23.5,2.8" />
              <polygon points="5.6,12.2 2.4,17.5 3.8,18 6.4,14" />
              <rect x="6" y="18" width="2" height="6" />
              <rect x="9.6" y="18" width="2" height="6" />
              <rect x="15" y="18" width="2" height="6" />
              <rect x="18.6" y="18" width="2" height="6" />
              <rect x="3.5" y="24" width="20" height="2.2" />
              <circle cx="8" cy="28.5" r="2.6" />
              <circle cx="19" cy="28.5" r="2.6" />
            </g>
          </svg>
          <span class="brand-name">Goya</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <div class="shell layout">
      <aside class="strata" aria-labelledby="strata-label">
        <p class="strata-label" id="strata-label">Layers</p>
        <ol class="strata-list" aria-label="Portfolio layers">
          {layers.map((layer) => (
            <li
              class:list={['layer', { 'layer-built': layer.built, 'layer-future': !layer.built }]}
              aria-current={layer.current ? 'step' : undefined}
            >
              <span class="layer-phase"><span class="layer-word">Phase </span>{layer.phase}</span><span class="layer-name"><span class="layer-dot"> · </span>{layer.name}</span>
              {layer.current && <span class="layer-now" aria-hidden="true">Current</span>}
              {!layer.built && <span class="visually-hidden"> (not yet built)</span>}
            </li>
          ))}
        </ol>
        <p class="strata-key">Filled: built so far. Outlined: still to come.</p>
      </aside>

      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Wexmoor, the company in this portfolio, is fictional: its staff, customers, and data are invented.</p>
        <p><a href="https://github.com/goya-git-hub">GitHub</a></p>
      </div>
    </footer>
  </body>
</html>
